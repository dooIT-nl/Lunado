<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend product.template form: add Transport tab -->
    <record id="d1_product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.d1.transport</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='purchase']" position="after">
                <page string="Transport" name="d1_transport">
                    <group>
                        <group string="Shipping Class">
                            <field name="d1_shipping_class_id"/>
                        </group>
                        <group string="Dimensions (cm)">
                            <field name="d1_length_cm"/>
                            <field name="d1_width_cm"/>
                            <field name="d1_height_cm"/>
                        </group>
                    </group>
                    <group>
                        <group string="Order Line Calculation">
                            <field name="d1_use_qty"/>
                            <field name="d1_use_length"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
