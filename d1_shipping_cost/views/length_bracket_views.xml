<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view -->
    <record id="d1_shipping_length_bracket_list" model="ir.ui.view">
        <field name="name">d1.shipping.length.bracket.list</field>
        <field name="model">d1.shipping.length.bracket</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="length_from_cm"/>
                <field name="length_to_cm"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="d1_shipping_length_bracket_form" model="ir.ui.view">
        <field name="name">d1.shipping.length.bracket.form</field>
        <field name="model">d1.shipping.length.bracket</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="length_from_cm"/>
                            <field name="length_to_cm"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="d1_shipping_length_bracket_action" model="ir.actions.act_window">
        <field name="name">Lengteklassen</field>
        <field name="res_model">d1.shipping.length.bracket</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Maak een nieuwe lengteklasse aan
            </p>
            <p>
                Definieer bereiken in centimeters voor de TK1-tariefopzoeking.
                Gebruik 0 als bovengrens voor een open einde.
            </p>
        </field>
    </record>
</odoo>
