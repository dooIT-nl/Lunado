<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="d1_sale_order_view_form" model="ir.ui.view">
        <field name="name">sale.order.form.d1.dropshipment</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="d1_dropshipment"/>
            </xpath>
        </field>
    </record>

    <record id="d1_sale_order_view_tree" model="ir.ui.view">
        <field name="name">sale.order.list.d1.dropshipment</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="d1_dropshipment" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
