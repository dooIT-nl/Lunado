#. module: d1_purchase_partner_delivery
#: model:ir.model,name:d1_purchase_partner_delivery.model_res_partner
msgid "Contact"
msgstr "Contact"

#. module: d1_purchase_partner_delivery
#: model:ir.model.fields,help:d1_purchase_partner_delivery.field_res_partner__d1_incoterm_id
#: model:ir.model.fields,help:d1_purchase_partner_delivery.field_res_users__d1_incoterm_id
msgid ""
"Default incoterm for purchase orders of this vendor; applied together with "
"the delivery operation type."
msgstr ""
"Standaard leverconditie voor inkooporders van deze leverancier; wordt samen "
"met het leveroperatietype toegepast."

#. module: d1_purchase_partner_delivery
#: model:ir.model.fields,help:d1_purchase_partner_delivery.field_res_partner__d1_delivery_picking_type_id
#: model:ir.model.fields,help:d1_purchase_partner_delivery.field_res_users__d1_delivery_picking_type_id
msgid ""
"Default operation type (Deliver To) for purchase orders of this vendor. "
"Applied together with the incoterm below, unless the order's operation type "
"is excluded (e.g. Dropship)."
msgstr ""
"Standaard operatietype (Leveren aan) voor inkooporders van deze "
"leverancier. Wordt samen met de leverconditie hieronder toegepast, tenzij "
"het operatietype van de order is uitgesloten (bv. Dropship)."

#. module: d1_purchase_partner_delivery
