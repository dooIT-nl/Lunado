#. module: d1_purchase_partner_delivery
#: model:ir.model,name:d1_purchase_partner_delivery.model_res_partner
msgid "Contact"
msgstr "Kontakt"

#. module: d1_purchase_partner_delivery
#: model:ir.model.fields,help:d1_purchase_partner_delivery.field_res_partner__d1_incoterm_id
#: model:ir.model.fields,help:d1_purchase_partner_delivery.field_res_users__d1_incoterm_id
msgid ""
"Default incoterm for purchase orders of this vendor; applied together with "
"the delivery operation type."
msgstr ""
"Standard-Incoterm für Bestellungen dieses Lieferanten; wird zusammen mit "
"der Liefervorgangsart angewendet."

#. module: d1_purchase_partner_delivery
#: model:ir.model.fields,help:d1_purchase_partner_delivery.field_res_partner__d1_delivery_picking_type_id
#: model:ir.model.fields,help:d1_purchase_partner_delivery.field_res_users__d1_delivery_picking_type_id
msgid ""
"Default operation type (Deliver To) for purchase orders of this vendor. "
"Applied together with the incoterm below, unless the order's operation type "
"is excluded (e.g. Dropship)."
msgstr ""
"Standard-Vorgangsart (Liefern an) für Bestellungen dieses Lieferanten. "
"Wird zusammen mit dem untenstehenden Incoterm angewendet, es sei denn, die "
"Vorgangsart des Auftrags ist ausgeschlossen (z. B. Streckengeschäft)."

#. module: d1_purchase_partner_delivery
#: model:ir.model.fields,field_description:d1_purchase_partner_delivery.field_res_partner__d1_incoterm_id
#: model:ir.model.fields,field_description:d1_purchase_partner_delivery.field_res_users__d1_incoterm_id
msgid "Delivery Incoterm"
msgstr "Liefer-Incoterm"

#. module: d1_purchase_partner_delivery
#: model:ir.model.fields,field_description:d1_purchase_partner_delivery.field_res_partner__d1_delivery_picking_type_id
#: model:ir.model.fields,field_description:d1_purchase_partner_delivery.field_res_users__d1_delivery_picking_type_id
msgid "Delivery Operation Type"
msgstr "Liefervorgangsart"

