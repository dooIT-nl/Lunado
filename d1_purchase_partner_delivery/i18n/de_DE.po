#. module: d1_purchase_partner_delivery
#: model:ir.model,name:d1_purchase_partner_delivery.model_purchase_order
msgid "Purchase Order"
msgstr "Bestellung"

#. module: d1_purchase_partner_delivery
#: model:ir.model.fields,help:d1_purchase_partner_delivery.field_stock_picking_type__d1_no_partner_delivery_default
msgid ""
"When a purchase order uses this operation type, the vendor's delivery "
"operation type and incoterm are NOT applied (e.g. for Dropship orders)."
msgstr ""
"Wenn eine Bestellung diese Vorgangsart verwendet, werden die "
"Liefervorgangsart und der Incoterm des Lieferanten NICHT angewendet "
"(z. B. bei Streckengeschäft-Bestellungen)."
