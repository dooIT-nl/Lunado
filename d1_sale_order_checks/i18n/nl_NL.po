#. module: d1_sale_order_checks
#. odoo-python
#: code:addons/d1_sale_order_checks/models/sale_order.py:0
msgid ""
"Warning: the credit limit of %(partner)s has been exceeded (outstanding "
"%(credit).2f, limit %(limit).2f). Check 'Allow Exceeding Credit Limit' to "
"confirm anyway."
msgstr ""
"Let op: de kredietlimiet van %(partner)s is overschreden (openstaand "
"%(credit).2f, limiet %(limit).2f). Vink 'Overschrijding kredietlimiet "
"toestaan' aan om toch te bevestigen."

#. module: d1_sale_order_checks
#. odoo-python
