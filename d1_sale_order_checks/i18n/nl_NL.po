#. module: d1_sale_order_checks
#: model_terms:ir.ui.view,arch_db:d1_sale_order_checks.d1_sale_order_view_form
msgid ""
"<span>The customer's credit limit has been exceeded. Confirming is blocked "
"unless 'Allow Exceeding Credit Limit' is checked.</span>"
msgstr ""
"<span>De kredietlimiet van de klant is overschreden. Bevestigen is "
"geblokkeerd tenzij 'Overschrijding kredietlimiet toestaan' is aangevinkt."
