<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="d1_sale_order_view_form" model="ir.ui.view">
        <field name="name">sale.order.form.d1.order.checks</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-danger" role="alert"
                     invisible="not d1_credit_limit_exceeded or d1_exceed_credit_limit">
                    <span>The customer's credit limit has been exceeded. Confirming is blocked unless 'Allow Exceeding Credit Limit' is checked.</span>
                </div>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="d1_credit_limit_exceeded" invisible="1"/>
                <field name="d1_exceed_credit_limit"
                       invisible="not d1_credit_limit_exceeded and not d1_exceed_credit_limit"
                       readonly="state not in ('draft', 'sent')"/>
            </xpath>
        </field>
    </record>

</odoo>
