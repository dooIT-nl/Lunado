ienst', 'label_i18n': {'nl_NL': 'Extra dienst', 'en_US': 'Extra dienst', 'de_DE': 'Extra dienst'}, 'help': '', 'relation': 'product.template', 'relation_field': '', 'relation_table': '', 'column1': '', 'column2': '', 'required': False, 'readonly': False, 'store': True, 'index': False, 'copied': True, 'translate': False, 'related': '', 'depends': '', 'compute': '', 'domain': '[]', 'on_delete': 'set null', 'size': 0, 'tracking': 0, 'selection': [], 'xml_id': 'studio_customization.product_product_cate_7ffdeed8-22bc-425b-9356-848111b81385'}, {'model': 'sale.order.line', 'name': 'x_studio_frame_id', 'ttype': 'char', 'label': 'Frame ID', 'label_i18n': {'nl_NL': 'Frame ID', 'en_US': 'Frame ID', 'de_DE': 'Frame ID'}, 'help': '', 'relation': '', 'relation_field': '', 'relation_table': '', 'column1': '', 'column2': '', 'required': False, 'readonly': False, 'store': True, 'index': False, 'copied': True, 'translate': False, 'related': '', 'depends': '', 'compute': '', 'domain': '[]', 'on_delete': '', 'size': 0, 'tracking': 0, 'selection': [], 'xml_id': 'studio_customization.nieuw_tekst_sales_or_f211ade3-5eaf-432c-8336-3ecc022f7c12'}, {'model': 'sale.order.line', 'name': 'x_studio_frame_nr', 'ttype': 'char', 'label': 'Frame nr.', 'label_i18n': {'nl_NL': 'Frame nr.', 'en_US': 'Frame nr.', 'de_DE': 'Frame nr.'}, 'help': '', 'relation': '', 'relation_field': '', 'relation_table': '', 'column1': '', 'column2': '', 'required': False, 'readonly': True, 'store': True, 'index': False, 'copied': False, 'translate': False, 'related': '', 'depends': 'x_studio_frame_id', 'compute': 'for record in self:\n    order_name = record.order_id.name or \'\'\n    frame_id = record.x_studio_frame_id or \'\'\n    frame_nr = False\n    \n    if frame_id: # Alleen berekenen als er een frame_id is\n        if  order_name.startswith(\'S\'):\n            order_part = order_name[1:] # Verwijder eerste letter \'S\'\n        else:\n            order_part = order_name\n        \n        if len(frame_id) >= 3:\n            frame_suffix = frame_id[-3:]  # Laatste 3 karakters\n        else:\n            frame_suffix = frame_id\n        \n        if order_part and frame_suffix:\n            frame_nr = f"{order_part}-{frame_suffix}"\n        elif order_part:\n            frame_nr = order_part\n        \n    record[\'x_studio_frame_nr\'] = frame_nr', 'domain': '[]', 'on_delete': '', 'size': 0, 'tracking': 0, 'selection': [], 'xml_id': 'studio_customization.nieuw_tekst_sales_or_142604d4-dd6f-4cac-bd49-43bc4a3898a7'}, {'model': 'mrp.production', 'name': 'x_studio_frame_nr', 'ttype': 'char', 'label': 'Frame nr.', 'label_i18n': {'nl_NL': 'Frame nr.', 'en_US': 'Frame nr.', 'de_DE': 'Frame nr.'}, 'help': '', 'relation': '', 'relation_field': '', 'relation_table': '', 'column1': '', 'column2': '', 'required': False, 'readonly': True, 'store': True, 'index': False, 'copied': False, 'translate': False, 'related': '', 'depends': 'reference_ids, user_id, product_id, move_dest_ids', 'compute': "for record in self:\r\n  if record.origin and record.sale_order_count!=0:\r\n    sale_order = record.env['sale.order'].search([('name','=',record.origin)])\r\n  if record.sale_order_count!=0:\r\n    record['x_studio_frame_nr'] = record.move_dest_ids.sale_line_id.x_studio_frame_nr", 'domain': '[]', 'on_delete': '', 'size': 0, 'tracking': 0, 'selection': [], 'xml_id': 'studio_customization.nieuw_tekst_producti_d4b698ec-6c81-49f0-b04c-1056589290f4'}, {'model': 'product.template', 'name': 'x_studio_framecalculator_janee', 'ttype': 'boolean', 'label': 'Framecalculator ja/nee', 'label_i18n': {'nl_NL': 'Framecalculator ja/nee', 'en_US': 'Framecalculator ja/nee', 'de_DE': 'Framecalculator ja/nee'}, 'help': '', 'relation': '', 'relation_field': '', 'relation_table': '', 'column1': '', 'column2': '', 'required': False, 'readonly': False, 'store': True, 'index': False, 'copied': True, 'translate': False, 'related': '', 'depends': '', 'compute': '', 'domain': '[]', 'on_delete': '', 'size': 0, 'tracking': 0, 'se