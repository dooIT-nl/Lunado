how"/>\n  </xpath>\n</data>', 'de_DE': '<data>\n  <xpath expr="//list[1]/field[@name=\'name\']" position="before">\n    <field name="id" optional="show"/>\n  </xpath>\n</data>'}, 'xml_id': 'studio_customization.odoo_studio_res_user_dce4dc46-0879-4d76-aeeb-a525bdc71530', 'is_d1_marked': False}], 'server_actions': [{'id': 672, 'name': 'Controle Product - Lengte', 'model': 'product.template', 'state': 'code', 'code': 'raise UserError("Als Gebruik Lengte is gemarkeerd dient ook Gebruik Hoeveelheid te worden gemarkeerd")', 'update_field': '', 'update_path': '', 'evaluation_type': '', 'value': '', 'selection_value': '', 'resource_ref': '', 'sequence': 5, 'child_ids': [], 'usage': 'base_automation', 'binding_model': '', 'xml_id': ''}, {'id': 673, 'name': 'Vul lengte in verkooporderregel', 'model': 'sale.order.line', 'state': 'code', 'code': "# # ToDo: in Triggerveld ook Hoeveelheid toevoegen en DM installeren\n# if record.product_template_id and record.x_studio_use_qty and not record.x_studio_use_length:\n#   record['x_studio_length']=record.product_id.dm_length/100\n\n\n\n", 'update_field': '', 'update_path': '', 'evaluation_type': '', 'value': '', 'selection_value': '', 'resource_ref': '', 'sequence': 5, 'child_ids': [], 'usage': 'base_automation', 'binding_model': '', 'xml_id': ''}, {'id': 580, 'name': 'Kredietlimiet', 'model': 'sale.order', 'state': 'code', 'code': 'raise UserError("Let op: Kredietlimiet is overschreden")\n\n\n\n', 'update_field': '', 'update_path': '', 'evaluation_type': '', 'value': '', 'selection_value': '', 'resource_ref': '', 'sequence': 5, 'child_ids': [], 'usage': 'base_automation', 'binding_model': '', 'xml_id': ''}, {'id': 581, 'name': 'Relatie is Prospect', 'model': 'sale.order', 'state': 'code', 'code': 'raise UserError("Let op: De geselecteerde debiteur is van het type Prospect!")', 'update_field': '', 'update_path': '', 'evaluation_type': '', 'value': '', 'selection_value': '', 'resource_ref': '', 'sequence': 5, 'child_ids': [], 'usage': 'base_automation', 'binding_model': '', 'xml_id': ''}, {'id': 680, 'name': 'Vul Leveren aan en Leverconditie', 'model': 'purchase.order', 'state': 'code', 'code': "record['picking_type_id']=record.partner_id.x_studio_type_levering\nrecord['incoterm_id']=record.partner_id.x_studio_incoterm_id", 'update_field': '', 'update_path': '', 'evaluation_type': '', 'value': '', 'selection_value': '', 'resource_ref': '', 'sequence': 5, 'child_ids': [], 'usage': 'base_automation', 'binding_model': '', 'xml_id': 'studio_customization.vul_leveren_aan_en_l_a67ac07a-df78-4cf4-9306-f1523114cc49'}, {'id': 681, 'name': 'Verkooporder: Dropshipment overnemen van klantgegevens', 'model': 'sale.order', 'state': 'code', 'code': "# Voer deze actie uit als gebruiker de API user is of Conneo\nif env.user.id in [11,13]:\n    record['x_studio_dropshipment']=record.partner_id.x_studio_dropshipment", 'update_field': '', 'update_path': '', 'evaluation_type': '', 'value': '', 'selection_value': '', 'resource_ref': '', 'sequence': 5, 'child_ids': [], 'usage': 'base_automation', 'binding_model': '', 'xml_id': ''}, {'id': 682, 'name': 'Verkooporder: Dropshipment overnemen van klantgegevens', 'model': 'sale.order', 'state': 'code', 'code': "if record.partner_id:\n  record['x_studio_dropshipment']=record.partner_id.x_studio_dropshipment", 'update_field': '', 'update_path': '', 'evaluation_type': '', 'value': '', 'selection_value': '', 'resource_ref': '', 'sequence': 5, 'child_ids': [], 'usage': 'base_automation', 'binding_model': '', 'xml_id': ''}, {'id': 683, 'name': 'Voeg dienst toe', 'model': 'sale.order.line', 'state': 'code', 'code': "for record in records:\n  aantal = 0\n  gevonden = False\n  # Zoek of er aan de Productcategorie van het artikel een Extra dienst is gekoppeld\n  dienst = record.product_template_id.categ_id.x_studio_extra_dienst.id\n  \n  # Als een Extra dienst is gekoppeld dan moet de Hoeveelheid worden gesommeerd voor alle regels die hetzelfde dienst artikel hebben\n  if dienst:\n    #Zoek eerst of in de verkooporder al de Extra dienst artikel is toegevoegd\n    for line in env['sale.order.line'].search(['&',('order_id','=',record.order_id.id),('product_template_id','=',dienst)]):\n      gevonden = True\n      #Als het Extra dienst artikel is gevonden in de verkooporder, \n      #sommeer dan de Hoeveelheid voor alle artikelen met hetzelfde Extra dienst artikel gkoppeld aan de Productcategorie\n      for regels in env['sale.order.line'].search([('order_id','=',record.order_id.id)]):\n        if regels.product_template_id.categ_id.x_studio_extra_dienst.id:\n          aantal += regels.x_studio_qty\n        line.update({'product_uom_qty': aantal })\n\n    #Als in de verkooporder het Extra dienst artikel niet is toegevoegd, voeg deze dan toe\n    if not gevonden:\n      aantal = record.x_studio_qty\n      order = env['sale.order'].search([('id','=',record.order_id.id)])\n      order['order_line'] = [(0, 0, {\n        'product_id': record.product_template_id.categ_id.x_studio_extra_dienst.product_variant_id.id,\n        'product_template_id': dienst,\n        'product_uom_qty': aantal\n      })]", 'update_field': '', 'update_path': '', 'evaluation_type': '', 'value': '', 'selection_value': '', 'resource_ref': '', 'sequence': 5, 'child_ids': [], 'usage': 'base_automation', 'binding_model': '', 'xml_id': ''}, {'id': 684, 'name': 'Werkorder: Duur vullen', 'model': 'mrp.workorder', 'state': 'code', 'code': "record['duration']=record.production_id.x_studio_productietijd\nrecord['duration_expected']=record.production_id.x_studio_productietijd", 'update_field': '', 'update_path': '', 'evaluation_type': '', 'value': '', 'selection_value': '', 'resource_ref': '', 'sequence': 5, 'child_ids': [], 'usage': 'base_automation', 'binding_model': '', 'xml_id': ''}, {'id': 685, 'name': 'Werkorder: Verwachte duur vullen', 'model': 'mrp.workorder', 'state': 'code', 'code': "record['duration_expected']=record.production_id.x_studio_productietijd", 'update_field': '', 'update_path': '', 'evaluation_type': '', 'value': '', 'selection_value': '', 'resource_ref': '', 'sequence': 5, 'child_ids': [], 'usage': 'base_automation', 'binding_model': '', 'xml_id': ''}, {'id': 814, 'name': 'Voer Python code uit', 'model': 'sale.order', 'state': 'code', 'code': 'if record.x_studio_combi:\r\n    for line in record.order_line:\r\n        if not line.product_template_id.x_studio_default_warehouse_id and line.product_template_id.type in [\'consu\',\'product\']:\r\n            raise UserError("Het veld Standaard magazijn is voor " +line.product_template_id.name+ " niet gevuld")\r\n        else:\r\n            if line.product_template_id.x_studio_default_warehouse_id!=record.warehouse_id:\r\n                if record.warehouse_id.id==1:\r\n                    line[\'route_id\']= 21\r\n                elif record.warehouse_id.id==2:\r\n                    line[\'route_id\']= 22\r\n                else:\r\n                    raise UserError("Combi orders voor" +record.warehouse_id+ " is nog niet actief")', 'update_field': '', 'update_path': '', 'evaluation_type': 'value', 'value': '', 'selection_value': '', 'resource_ref': '', 'sequence': 5, 'child_ids': [], 'usage': 'base_automation', 'binding_model': '', 'xml_id': ''}, {'id': 687, 'name': 'Verkoop: Voeg Handling toe', 'model': 'sale.order', 'state': 'code', 'code': 'if record.state in ["draft"]:\r\n  for record in records:\r\n    handling = record.partner_id.x_studio_handling.id\r\n    handling_product = record.partner_id.x_studio_handling.x_studio_product\r\n    \r\n    # Als er handling is ingesteld voor de klant\r\n    if handling:\r\n        # Bereken Totaalbedrag\r\n        totaal=0\r\n        for line in record.order_line:\r\n        # Artikel 9232 staat voor Shipping cost met interne referentie DeliveryMatch\r\n          if not (line.product_template_id == handling_product or line.product_template_id.id == 9232):\r\n            totaal += line.price_subtotal\r\n        #raise UserError(totaal)  \r\n       # totaal = record.amount_untaxed\r\n         \r\n        # Zoek naar de juiste handling range\r\n        handling_line = env[\'x_handling_line_b0f2a\'].search([\'&\',\'&\',\r\n            (\'x_handling_id\', \'=\', handling),\r\n            (\'x_studio_van\', \'<=\', totaal),\r\n            (\'x_studio_tot\', \'>\', totaal)\r\n        ], limit=1)  # \'limit=1\' om slechts één resultaat te krijgen\r\n        \r\n        # Controleer of er al een order line bestaat met dit handling product\r\n        bestaande_regel = env[\'sale.order.line\'].search([\'&\',\r\n            (\'order_id\', \'=\', record.id),\r\n            (\'product_template_id\', \'=\', handling_product.id)\r\n        ], limit=1)\r\n        \r\n        if handling_line:\r\n          if bestaande_regel:\r\n            # Als de regel al bestaat, werk dan het bedrag bij\r\n            bestaande_regel.write({\r\n              \'price_unit\': handling_line.x_studio_bedrag\r\n            })\r\n          else:\r\n            # Als er geen regel bestaat, voeg een nieuwe order line toe\r\n            record[\'order_line\'] = [(0, 0, {\r\n                \'product_id\': handling_product.product_variant_id.id,\r\n                \'product_template_id\': handling_product.id,\r\n                \'product_uom_qty\': 1,\r\n                \'price_unit\': handling_line.x_studio_bedrag,\r\n                \'sequence\': 99,\r\n            })]\r\n        elif bestaande_regel:\r\n            # Als er geen handling_line is maar wel een bestaande regel, verwijder de bestaande regel\r\n            bestaande_regel.unlink()\r\n', 'update_field': '', 'update_path': '', 'evaluation_type': '', 'value': '', 'selection_value': '', 'resource_ref': '', 'sequence': 5, 'child_ids': [], 'usage': 'base_automation', 'binding_model': '', 'xml_id': ''}, {'id': 688, 'name': 'Verkooporder: Dubbele referentie', 'model': 'sale.order', 'state': 'code', 'code': 'if record.partner_id:\r\n  row = env[\'sale.order\'].search([\'&\',\'&\', (\'partner_id\',\'=\',record.partner_id.id),(\'id\',\'<>\',record.id),(\'client_order_ref\',\'=\',record.client_order_ref)])\r\n  if row and record.client_order_ref:\r\n    raise  UserError(("The entered Customer Reference is already registered for this Customer"))', 'update_field': '', 'update_path': '', 'evaluation_type': '', 'value': '', 'selection_value': '', 'resource_ref': '', 'sequence': 5, 'child_ids': [], 'usage': 'base_automation', 'binding_model': '', 'xml_id': ''}, {'id': 689, 'name': 'Verkooporder: Dubbele referentie', 'model': 'sale.order', 'state': 'code', 'code': 'if env.user.id in [11,13] and record.partner_id:\r\n  row = env[\'sale.order\'].search([\'&\',\'&\', (\'partner_id\',\'=\',record.partner_id.id),(\'id\',\'<>\',record.id),(\'client_order_ref\',\'=\',record.client_order_ref)])\r\n  if row and record.client_order_ref:\r\n    raise  UserError(("The entered Customer Reference is already registered for this Customer"))', 'update_field': '', 'update_path': '', 'evaluation_type': '', 'value': '', 'selection_value': '', 'resource_ref': '', 'sequence': 5, 'child_ids': [], 'usage': 'base_automation', 'binding_model': '', 'xml_id': ''}, {'id': 815, 'name': 'Voer Python code uit', 'model': 'sale.order.line', 'state': 'code', 'code': 'if record.order_id.x_studio_combi:\r\n    if not record.product_template_id.x_studio_default_warehouse_id and record.product_template_id.type in [\'consu\',\'product\']:\r\n        raise UserError("Het veld Standaard magazijn is voor " +record.product_template_id.name+ " niet gevuld")\r\n    else:\r\n        if record.product_template_id.x_studio_default_warehouse_id!=record.order_id.warehouse_id:\r\n            if record.order_id.warehouse_id.id==1:\r\n                record[\'route_id\']= 21\r\n            elif record.order_id.warehouse_id.id==2:\r\n                record[\'route_id\']= 22\r\n            else:\r\n                raise UserError("Combi orders voor " +record.order_id.warehouse_id+ " is nog niet actief")',