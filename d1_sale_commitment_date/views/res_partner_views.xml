<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="d1_res_partner_view_form" model="ir.ui.view">
        <field name="name">res.partner.form.d1.commitment.date</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale']//field[@name='user_id']" position="after">
                <field name="d1_delivery_cutoff_hour" widget="float_time"/>
            </xpath>
        </field>
    </record>

    <!-- Optionele lijstkolom met tijdnotatie (bevinding CIS20260925: een via
         Studio toegevoegde kolom toonde het veld als kaal getal) -->
    <record id="d1_res_partner_view_tree" model="ir.ui.view">
        <field name="name">res.partner.list.d1.commitment.date</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="d1_delivery_cutoff_hour" widget="float_time" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
