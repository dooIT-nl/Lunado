<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="d1_product_template_view_form" model="ir.ui.view">
        <field name="name">product.template.form.d1.combi</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='operations']" position="after">
                <group string="Combi" name="d1_combi">
                    <field name="d1_default_warehouse_id"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
