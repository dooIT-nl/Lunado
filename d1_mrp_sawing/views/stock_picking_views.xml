<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="d1_stock_picking_view_form" model="ir.ui.view">
        <field name="name">stock.picking.form.d1.sawing</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids']//list//field[@name='product_id']" position="after">
                <field name="d1_qty" optional="show"/>
                <field name="d1_length" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
