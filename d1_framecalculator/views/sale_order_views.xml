<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="d1_sale_order_view_form" model="ir.ui.view">
        <field name="name">sale.order.form.d1.framecalculator</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_preview_sale_order']" position="after">
                <button name="action_d1_open_framecalculator"
                        type="object"
                        string="Framecalculator"
                        invisible="state == 'cancel'"/>
            </xpath>
        </field>
    </record>

</odoo>
