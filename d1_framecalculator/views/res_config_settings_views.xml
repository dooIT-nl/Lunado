<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="d1_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.d1.framecalculator</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='sale_management']" position="inside">
                <block title="Framecalculator" name="d1_framecalculator_setting_container">
                    <setting id="d1_framecalculator_url_setting"
                             string="Framecalculator"
                             help="External frame calculator opened from the sale order">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="d1_framecalculator_url" class="col-lg-4 o_light_label"/>
                                <field name="d1_framecalculator_url"/>
                            </div>
                            <div class="row">
                                <label for="d1_framecalculator_api_key" class="col-lg-4 o_light_label"/>
                                <field name="d1_framecalculator_api_key" password="True"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
